# ==============================================================================
# NexTrial - Clinical Trial Management System for Ayurvedic Research
# Environment Configuration Template
# Academic Prototype - Synthetic Data Only
# ==============================================================================

# Server Environment
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# MongoDB Configuration
# In Docker Compose, service is named 'mongo'
MONGO_URI=mongodb://mongo:27017/nextrial
# For local development without Docker:
# MONGO_URI=mongodb://127.0.0.1:27017/nextrial

# Security & JWT Tokens
JWT_SECRET=super_secret_jwt_key_replace_in_production_32chars!
JWT_REFRESH_SECRET=super_secret_refresh_key_replace_in_production_64chars!
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Machine Learning Service URL
ML_SERVICE_URL=http://ml:8000
# For local development without Docker:
# ML_SERVICE_URL=http://localhost:8000

# Client Configuration
VITE_API_URL=http://localhost:5000/api/v1

# Default Seed Passwords (for npm run seed)
SEED_ADMIN_PASSWORD=Admin@NexTrial2026!
SEED_COORDINATOR_PASSWORD=Coordinator@NexTrial2026!
SEED_INVESTIGATOR_PASSWORD=Investigator@NexTrial2026!
SEED_IEC_PASSWORD=IECMember@NexTrial2026!
SEED_PV_PASSWORD=PVOfficer@NexTrial2026!
SEED_DSMB_PASSWORD=DSMBReviewer@NexTrial2026!
